# Variables de entorno — copia este archivo como .env y rellena los valores

# URL de tu proyecto Supabase (ej. https://xyzabc.supabase.co)
SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave pública publicable de Supabase (publishable key)
# Se encuentra en: Supabase Dashboard → Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=<tu-publishable-key>

# Proveedor OAuth2 por defecto cuando no se envía ?provider en /auth/login
# Opciones soportadas por este proyecto: github | google
# Ambos deben estar habilitados en: Supabase Dashboard → Authentication → Providers
OAUTH_PROVIDER=google

# URL pública de tu aplicación (sin barra final)
# En desarrollo usa http://localhost:3000
# En producción usa tu dominio real
APP_URL=http://localhost:3000

# Secreto para firmar las cookies (cámbialo en producción)
COOKIE_SECRET=cambia-este-secreto-en-produccion

# Puerto del servidor (por defecto 3000)
PORT=3000
